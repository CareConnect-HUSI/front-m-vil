<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    tools:context=".logInPage.infoPacientes.VisitaPaciente">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

    <!-- Header -->
    <include
        android:id="@+id/encabezado"
        layout="@layout/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"/>

    <!-- Imagen y nombre del paciente -->
    <LinearLayout
        android:id="@+id/encabezado_paciente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/encabezado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/detalle_avatar_paciente"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/image_avatar"
            android:contentDescription="Avatar del Paciente"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:id="@+id/detalle_nombre_paciente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre Paciente"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Hora de llegada y salida -->
    <LinearLayout
        android:id="@+id/hora_llegada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/encabezado_paciente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/boton_hora_llegada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hora de llegada:"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/hora_llegada_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="00:00"
            android:textColor="@color/black"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hora de salida:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="20dp"/>

        <TextView
            android:id="@+id/hora_salida_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="00:00"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_marginStart="5dp"/>

        <ImageView
            android:id="@+id/boton_hora_salida"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/image_clock"
            android:padding="5dp"
            android:layout_marginStart="10dp"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <!-- Comentarios -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/comentarios"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/listainsumos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Comentarios"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Procedimiento -->
    <TextView
        android:id="@+id/procedimientosText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Procedimientos"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/hora_llegada"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp"/>

    <View
        android:id="@+id/linea_divisoria"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/app_gray"
        app:layout_constraintTop_toBottomOf="@id/procedimientosText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="5dp"/>

    <LinearLayout
        android:id="@+id/procedimientos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/linea_divisoria"
        android:layout_marginTop="16dp">

        <CheckBox
            android:id="@+id/checkBox1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aplicar medicamento #1"/>

        <CheckBox
            android:id="@+id/checkBox2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aplicar medicamento #2"/>
    </LinearLayout>

    <!-- Insumos -->
    <TextView
        android:id="@+id/insumosText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Insumos"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/procedimientos"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp"/>

    <View
        android:id="@+id/linea_divisoria_insumo"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/app_gray"
        app:layout_constraintTop_toBottomOf="@id/insumosText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="5dp"/>

    <!-- Barra de búsqueda -->
    <androidx.cardview.widget.CardView
        android:id="@+id/barra_busqueda"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:radius="10dp"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/linea_divisoria_insumo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:hint="Buscar insumo"
                android:background="@android:color/transparent"/>

            <ImageView
                android:id="@+id/search_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/image_search"
                android:contentDescription="Buscar"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Lista de resultados -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listainsumos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/barra_busqueda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/guardar_datos"
        android:layout_width="350dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/app_blue"
        android:text="Guardar Datos"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/comentarios"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
