<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/white"
    tools:context=".logInPage.infoPacientes.DetallePacienteActivity">

    <!-- Imagen y nombre del paciente -->
    <LinearLayout
        android:id="@+id/encabezado_paciente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/detalle_avatar_paciente"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/image_avatar"
            android:contentDescription="Avatar del Paciente"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:id="@+id/detalle_nombre_paciente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre Paciente"
            android:textSize="24sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Información del paciente -->
    <LinearLayout
        android:id="@+id/info_paciente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/encabezado_paciente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edad"
            android:textSize="16sp"
            android:textColor="@color/black"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diagnóstico"
            android:textSize="16sp"
            android:textColor="@color/black"/>
    </LinearLayout>

    <!-- Línea divisoria -->
    <View
        android:id="@+id/linea_divisoria"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@id/info_paciente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Selección de horas -->
    <LinearLayout
        android:id="@+id/hora_llegada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linea_divisoria"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hora de llegada:"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/hora_llegada_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:paddingStart="8dp"/>

        <Button
            android:id="@+id/boton_hora_llegada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seleccionar"
            android:backgroundTint="@color/app_gray"
            android:layout_marginStart="5dp"/>
    </LinearLayout>

    <!-- Lista de medicamentos con CheckBoxes y Spinner -->
    <LinearLayout
        android:id="@+id/checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        app:layout_constraintTop_toBottomOf="@id/hora_llegada"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/checkBox1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aplicar"/>

            <Spinner
                android:id="@+id/spinner1"
                android:layout_width="wrap_content"
                android:layout_height="48dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/checkBox2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aplicar"/>

            <Spinner
                android:id="@+id/spinner2"
                android:layout_width="wrap_content"
                android:layout_height="48dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Hora de salida -->
    <LinearLayout
        android:id="@+id/hora_salida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/checkbox"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hora de salida:"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/hora_salida_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:paddingStart="8dp"/>

        <Button
            android:id="@+id/boton_hora_salida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seleccionar"
            android:backgroundTint="@color/app_gray"
            android:layout_marginStart="5dp"/>
    </LinearLayout>


    <!-- Botones -->
    <Button
        android:id="@+id/registrar_insumos_button"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:text="Registrar Insumos"
        android:textAllCaps="false"
        android:backgroundTint="@color/app_blue"
        android:textColor="@android:color/white"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/hora_salida"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/guardar_datos_button"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:text="Guardar Datos"
        android:textAllCaps="false"
        android:backgroundTint="@color/app_blue"
        android:textColor="@android:color/white"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/registrar_insumos_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
